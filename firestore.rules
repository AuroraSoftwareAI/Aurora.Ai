rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid;
    }

    function isValidKnowledgeSource(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 &&
             data.content is string;
    }

    function isValidChatSession(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.sessionId is string &&
             data.title is string;
    }

    function isValidChatMessage(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.sessionId is string &&
             data.content is string &&
             (data.role == 'user' || data.role == 'model');
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);

      match /knowledgeSources/{sourceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidKnowledgeSource(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /chatSessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidChatSession(request.resource.data);
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidChatMessage(request.resource.data);
          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
